# PhysicsOS OpenAI-compatible model config.
# Fill this value yourself. Do not commit real keys.
PHYSICSOS_OPENAI_API_KEY=

# For most OpenAI-compatible SDKs, base_url should point at the API root that
# contains /chat/completions or /responses underneath.
# Base URL should be the /v1 API root. LangChain/OpenAI SDK appends
# /chat/completions or /responses depending on mode.
PHYSICSOS_OPENAI_BASE_URL=https://api.openai.com/v1
PHYSICSOS_OPENAI_MODEL=gpt-5.4
PHYSICSOS_DEEPSEARCH_MODEL=gemini-2.5-pro-deepsearch

# Set true if your provider requires /v1/responses instead of /v1/chat/completions.
PHYSICSOS_OPENAI_USE_RESPONSES_API=false

# Optional local surrogate registry override.
PHYSICSOS_SURROGATE_REGISTRY=configs/surrogates.local.json

# Optional PaMO surface repair worker. CUDA dependencies remain in this worker.
# Set executor=docker on an NVIDIA Docker host after building runners/pamo.
PHYSICSOS_PAMO_EXECUTOR=python
# PHYSICSOS_PAMO_PYTHON=/path/to/pamo/environment/bin/python
PHYSICSOS_PAMO_DOCKER_IMAGE=physicsos-pamo:latest
